{
  "type": "ha/number",
  "kind": "sink",
  "eventSource": true,
  "label": "ha number",
  "group": "home assistant",
  "color": "#18bcf2",
  "bgcolor": "#0b4a63",
  "icon": "#",
  "description": "A number in Home Assistant, set with a slider or a box. Sends the value when it's changed in HA. Wire the real value back to the input so HA shows it; left unwired, the node confirms each change itself. Needs an ha device node in the flow.",
  "ports": { "inputs": [{ "name": "msg", "type": "any" }], "outputs": [{ "name": "msg", "type": "number" }] },
  "properties": [
    { "name": "name", "label": "name", "kind": "text", "default": "Number" },
    { "name": "min", "label": "min", "kind": "number", "default": 0 },
    { "name": "max", "label": "max", "kind": "number", "default": 100 },
    { "name": "step", "label": "step", "kind": "number", "default": 1 },
    { "name": "unit", "label": "unit", "kind": "text", "default": "" },
    { "name": "mode", "label": "mode", "kind": "select", "default": "slider",
      "options": [ { "value": "slider", "label": "slider" }, { "value": "box", "label": "box" } ] },
    { "name": "nodeId", "label": "node id", "kind": "nodeId", "default": "" }
  ]
}
