      "properties": {
        "intervalMs": 30000
      }
    },
    {
      "id": "upfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "import time\nmsg['payload'] = time.ticks_ms() // 1000\nreturn msg\n",
        "outputCount": 1,
        "label": "uptime"
      }
    },
    {
      "id": "haup",
      "type": "ha/sensor",
      "properties": {
        "name": "Uptime",
        "deviceClass": "duration",
        "unit": "s",
        "stateClass": "measurement",
        "icon": ""
      }
    },
    {
      "id": "memfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "import gc\ngc.collect()\nmsg['payload'] = gc.mem_free() // 1024\nreturn msg\n",
        "outputCount": 1,
        "label": "free memory"
      }
    },
    {
      "id": "hamem",
      "type": "ha/sensor",
      "properties": {
        "name": "Free memory",
        "deviceClass": "none",
        "unit": "KB",
        "stateClass": "measurement",
        "icon": "mdi:memory"
      }
    },
    {
      "id": "hatest",
      "type": "ha/switch",
      "properties": {
        "name": "Test switch",
        "deviceClass": "none",
        "onStart": "off"
      }
    },
    {
      "id": "testfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "return msg\n",
        "outputCount": 1,
        "label": "report it back"
