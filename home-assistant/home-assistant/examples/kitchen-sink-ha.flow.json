{
  "formatVersion": 1,
  "flowName": "kitchen-sink-ha",
  "nodes": [
    {
      "id": "hadev",
      "type": "ha/device",
      "properties": {
        "deviceName": "",
        "area": "Kitchen",
        "prefix": "homeassistant",
        "brokerConfigId": "ef01cb90-dda3-4708-86a0-c7d52db02539",
        "wifiConfigId": "1b1ff863-cb83-4567-af04-4d720eee028b"
      }
    },
    {
      "id": "hadbg",
      "type": "thingstudio/debug",
      "properties": {
        "fullMessage": false
      }
    },
    {
      "id": "knob",
      "type": "thingstudio/adc",
      "properties": {
        "pin": 0,
        "mode": "relative",
        "delta": 2000,
        "lower": 45000,
        "upper": 46000,
        "sense": "outside",
        "pollMs": 60000
      }
    },
    {
      "id": "knobfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "msg['payload'] = msg['payload']['percent']\nreturn msg\n",
        "outputCount": 1,
        "label": "percent"
      }
    },
    {
      "id": "haknob",
      "type": "ha/sensor",
      "properties": {
        "name": "Knob",
        "deviceClass": "none",
        "unit": "%",
        "stateClass": "measurement",
        "icon": "mdi:knob"
      }
    },
    {
      "id": "btn",
      "type": "thingstudio/ebutton",
      "properties": {
        "pin": 3,
        "suppress": false,
        "senseMode": "auto",
        "debounceMs": 50,
        "longPressMs": 1000,
        "doubleClickMs": 400,
        "pull": "up"
      }
    },
    {
      "id": "btnfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "if msg['payload'] in ('press', 'release'):\n    msg['payload'] = msg['payload'] == 'press'\n    return msg\nreturn None\n",
        "outputCount": 1,
        "label": "pressed?"
      }
    },
    {
      "id": "habtn",
      "type": "ha/binary_sensor",
      "properties": {
        "name": "Button",
        "deviceClass": "none",
        "onStart": "off"
      }
    },
    {
      "id": "haled",
      "type": "ha/switch",
      "properties": {
        "name": "LED",
        "deviceClass": "none",
        "onStart": "off"
      }
    },
    {
      "id": "habright",
      "type": "ha/number",
      "properties": {
        "name": "Brightness",
        "min": 0,
        "max": 255,
        "step": 1,
        "unit": "",
        "mode": "slider",
        "onStart": "32"
      }
    },
    {
      "id": "ledfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "if msg['topic'] == 'LED':\n    context.set('on', bool(msg['payload']))\nelse:\n    context.set('bright', int(msg['payload']))\nb = context.get('bright', 32)\nmsg['payload'] = (b << 16 | b << 8 | b) if context.get('on', False) else 0\nreturn msg\n",
        "outputCount": 1,
        "label": "led colour"
      }
    },
    {
      "id": "pixel",
      "type": "thingstudio/neopixel",
      "properties": {
        "pin": 6,
        "count": 1,
        "order": "GRB"
      }
    },
    {
      "id": "tick",
      "type": "thingstudio/timer",
      "properties": {
        "intervalMs": 10000
      }
    },
    {
      "id": "tempfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "import esp32\nmsg['payload'] = round(esp32.mcu_temperature(), 1)\nreturn msg\n",
        "outputCount": 1,
        "label": "chip temperature"
      }
    },
    {
      "id": "hatemp",
      "type": "ha/sensor",
      "properties": {
        "name": "CPU temperature",
        "deviceClass": "temperature",
        "unit": "°C",
        "stateClass": "measurement",
        "icon": ""
      }
    },
    {
      "id": "hahello",
      "type": "ha/button",
      "properties": {
        "name": "Hello"
      }
    },
    {
      "id": "hellodbg",
      "type": "thingstudio/debug",
      "properties": {
        "fullMessage": false
      }
    }
  ],
