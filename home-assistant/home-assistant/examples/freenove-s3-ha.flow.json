{
  "formatVersion": 1,
  "flowName": "freenove-s3-ha",
  "nodes": [
    {
      "id": "hadev",
      "type": "ha/device",
      "properties": {
        "deviceName": "",
        "area": "",
        "prefix": "homeassistant",
        "brokerConfigId": "ef01cb90-dda3-4708-86a0-c7d52db02539",
        "wifiConfigId": "1b1ff863-cb83-4567-af04-4d720eee028b"
      }
    },
    {
      "id": "hadbg",
      "type": "thingstudio/debug",
      "properties": {
        "fullMessage": false
      }
    },
    {
      "id": "habright",
      "type": "ha/number",
      "properties": {
        "name": "Screen brightness",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "unit": "",
        "mode": "slider"
      }
    },
    {
      "id": "backlight",
      "type": "thingstudio/pwm_out",
      "properties": {
        "pin": 45,
        "freq": 1000
      }
    },
    {
      "id": "hanight",
      "type": "ha/switch",
      "properties": {
        "name": "Night mode",
        "deviceClass": "switch"
      }
    },
    {
      "id": "nightfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "flow.set('night', bool(msg['payload']))\nmsg['payload'] = flow.get('night')\nreturn msg",
        "outputCount": 1,
        "label": "remember night mode"
      }
    },
    {
      "id": "nightdbg",
      "type": "thingstudio/debug",
      "properties": {
        "fullMessage": false
      }
    },
    {
      "id": "tick",
      "type": "thingstudio/timer",
      "properties": {
        "intervalMs": 10000
      }
    },
    {
      "id": "tempfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "import esp32\nmsg['payload'] = round(esp32.mcu_temperature(), 1)\nreturn msg",
        "outputCount": 1,
        "label": "chip temperature"
      }
    },
    {
      "id": "hatemp",
      "type": "ha/sensor",
      "properties": {
        "name": "CPU temperature",
        "deviceClass": "temperature",
        "unit": "°C",
        "stateClass": "measurement",
        "icon": ""
      }
    },
    {
      "id": "hotfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "msg['payload'] = msg['payload'] > 60\nreturn msg",
        "outputCount": 1,
        "label": "over 60 °C?"
      }
    },
    {
      "id": "hahot",
      "type": "ha/binary_sensor",
      "properties": {
        "name": "Running hot",
        "deviceClass": "problem"
      }
    },
    {
      "id": "memfn",
      "type": "thingstudio/function",
      "properties": {
        "code": "import gc\ngc.collect()\nmsg['payload'] = gc.mem_free() // 1024\nreturn msg",
        "outputCount": 1,
        "label": "free memory"
      }
    },
    {
      "id": "hamem",
      "type": "ha/sensor",
      "properties": {
        "name": "Free memory",
        "deviceClass": "none",
        "unit": "KB",
        "stateClass": "measurement",
        "icon": "mdi:memory"
      }
    },
    {
      "id": "hamode",
      "type": "ha/select",
      "properties": {
        "name": "Mode",
        "options": "normal\nnight\naway"
      }
    },
    {
      "id": "modedbg",
      "type": "thingstudio/debug",
      "properties": {
        "fullMessage": false
      }
    },
    {
      "id": "hahello",
      "type": "ha/button",
      "properties": {
        "name": "Hello"
      }
    },
    {
      "id": "hellodbg",
      "type": "thingstudio/debug",
      "properties": {
        "fullMessage": false
      }
    }
